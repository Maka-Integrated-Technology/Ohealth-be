NODE_ENV=development
PORT=3000
APP_NAME=OHealth
APP_SLUG=ohealth
APP_DESCRIPTION=OHealth Application
LOGO_URL=
FRONTEND_URL=
CORS_ORIGINS=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false

# JWT
JWT_SECRET=
TOKEN_ACCESS_DURATION=15m
TOKEN_REFRESH_DURATION=7d


# Security
HASH_SALT=10
# Required for distributed auth rate limits. Generate with a secure random generator.
AUTH_CHALLENGE_PEPPER=
# Independently generated 32-byte base64 AES-GCM key for challenge delivery.
AUTH_CHALLENGE_DELIVERY_KEY=
# Independently managed 32-byte base64 key-encryption key for MFA envelopes.
MFA_ENCRYPTION_KEY=
# Privileged categories that lose elevated capabilities until MFA is active.
MFA_REQUIRED_CATEGORIES=platform_admin,organization_owner,organization_admin
# Only enable after the worker, secrets, migrations and monitoring are live.
AUTH_CHALLENGE_FLOWS_ENABLED=false
# Explicit comma-separated load-balancer/reverse-proxy CIDRs; leave blank for direct clients.
AUTH_TRUSTED_PROXY_CIDRS=
# Enables the dedicated browser cookie endpoints. Deployed environments require
# exact HTTPS CORS_ORIGINS entries; no wildcard or reflected origin is allowed.
AUTH_BROWSER_SESSION_ENABLED=false
# Trusted HTTPS browser/mobile-link fallback. Do not include query or fragment.
AUTH_RECOVERY_CONTINUATION_URL=https://app.example.com/reset-password
INVITE_EXPIRATION_DAYS=7
# Currently published legal-document versions accepted by public registration.
REGISTRATION_TERMS_VERSION=
REGISTRATION_PRIVACY_VERSION=
# Separate server-held HMAC secret for registration retry receipts (32+ random bytes).
REGISTRATION_IDEMPOTENCY_PEPPER=

# Mail
# Driver selection: "smtp" (local dev via Mailpit) or "resend" (prod/staging).
MAIL_MAILER=smtp
# SMTP settings (used when MAIL_MAILER=smtp). Mailpit defaults below.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
# Resend settings (used when MAIL_MAILER=resend)
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_ENABLED=false
# Comma-separated allowlists; each transaction binds one exact audience from the consumer allowlist.
GOOGLE_WEB_CLIENT_IDS=
GOOGLE_MOBILE_CLIENT_IDS=

# Private mutable object storage (Backblaze B2; provisioned in #163)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PRIVATE_BUCKET=
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Offline auth-audit archive (separate Object-Locked B2 bucket and key)
AUTH_AUDIT_RETENTION_DATABASE_URL=
AUTH_AUDIT_ARCHIVE_ENDPOINT=
AUTH_AUDIT_ARCHIVE_REGION=
AUTH_AUDIT_ARCHIVE_ACCESS_KEY_ID=
AUTH_AUDIT_ARCHIVE_SECRET_ACCESS_KEY=
AUTH_AUDIT_ARCHIVE_BUCKET=
AUTH_AUDIT_ARCHIVE_FORCE_PATH_STYLE=false
AUTH_AUDIT_RETENTION_INITIATOR=
AUTH_AUDIT_RETENTION_APPROVAL_REFERENCE=


# OpenRouter AI Chat Config
OPENROUTER_API_KEY=openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.4-nano
# TOKEN_REFRESH_DURATION=7d
