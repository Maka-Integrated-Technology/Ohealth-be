NODE_ENV=development
PORT=3000
APP_NAME=OHealth
APP_SLUG=ohealth
APP_DESCRIPTION=OHealth Application
LOGO_URL=
FRONTEND_URL=

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false

# JWT
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me
TOKEN_ACCESS_DURATION=15m
TOKEN_REFRESH_DURATION=7d


# Security
HASH_SALT=10
# Required for distributed auth rate limits. Generate with a secure random generator.
AUTH_CHALLENGE_PEPPER=
# Independently generated 32-byte base64 AES-GCM key for challenge delivery.
AUTH_CHALLENGE_DELIVERY_KEY=
# Only enable after the worker, secrets, migrations and monitoring are live.
AUTH_CHALLENGE_FLOWS_ENABLED=false
# Explicit comma-separated load-balancer/reverse-proxy CIDRs; leave blank for direct clients.
AUTH_TRUSTED_PROXY_CIDRS=
INVITE_EXPIRATION_DAYS=7

# Mail
# Driver selection: "smtp" (local dev via Mailpit) or "resend" (prod/staging).
MAIL_MAILER=smtp
# SMTP settings (used when MAIL_MAILER=smtp). Mailpit defaults below.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
# Resend settings (used when MAIL_MAILER=resend)
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Google
GOOGLE_CLIENT_ID=

# AWS S3 Storage
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PRIVATE_BUCKET=
AWS_S3_SIGNED_URL_TTL_SECONDS=300


# OpenRouter AI Chat Config
OPENROUTER_API_KEY=openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.4-nano
# TOKEN_REFRESH_DURATION=7d

# Internal registration: approved legal versions and a separate managed HMAC secret.
REGISTRATION_TERMS_VERSION=
REGISTRATION_PRIVACY_VERSION=
REGISTRATION_IDEMPOTENCY_PEPPER=
