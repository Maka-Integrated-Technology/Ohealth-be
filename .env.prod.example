# Copy to .env.prod on the server and fill in real values. Never commit .env.prod.
#
# DB_* are injected by docker-compose.prod.yml to point at the `postgres`
# service, so you only set the POSTGRES_* credentials here.

NODE_ENV=production
PORT=3000
APP_NAME=OHealth
APP_SLUG=ohealth
APP_DESCRIPTION=OHealth Application
LOGO_URL=
FRONTEND_URL=

# PostgreSQL container credentials (the app's DB_* are derived from these)
POSTGRES_USER=ohealth
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=ohealth_app_db

# JWT — generate each with: openssl rand -hex 32
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me
TOKEN_ACCESS_DURATION=15m
TOKEN_REFRESH_DURATION=7d

# Security
HASH_SALT=10
INVITE_EXPIRATION_DAYS=7

# Mail (production/staging use Resend — https://resend.com)
# The MAIL_FROM_ADDRESS domain must be verified in the Resend dashboard.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Google
GOOGLE_CLIENT_ID=

# AWS S3 Storage
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PRIVATE_BUCKET=
AWS_S3_SIGNED_URL_TTL_SECONDS=300

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenRouter AI
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.4-nano
