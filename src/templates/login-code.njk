<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your {{ app_name }} login code</title>
  </head>
  <body style="margin: 0; padding: 24px; background: #f3f4f6; font-family: Arial, sans-serif; color: #111827">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px; background: #ffffff; border-radius: 12px">
            <tr>
              <td style="padding: 32px">
                <h1 style="margin: 0 0 20px; font-size: 24px">Confirm your sign-in</h1>
                <p style="font-size: 16px; line-height: 24px">Hello {{ name }},</p>
                <p style="font-size: 16px; line-height: 24px">
                  Enter this one-time code to finish signing in to {{ app_name }}:
                </p>
                <p style="margin: 28px 0; font-size: 32px; font-weight: 700; letter-spacing: 8px">
                  {{ code }}
                </p>
                <p style="font-size: 14px; line-height: 22px">
                  This code expires in {{ expiry_minutes }} minutes and can be used only once.
                  If you did not try to sign in, you can ignore this message.
                </p>
                <p style="font-size: 12px; line-height: 18px; word-break: break-all; color: #6b7280">
                  Sign-in request ID: {{ challenge_id }}
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
