{
  "name": "ohealth-backend",
  "version": "0.0.1",
  "description": "OHealth backend service",
  "author": "",
  "private": true,
  "workspaces": [
    "packages/api-client"
  ],
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:create": "typeorm migration:create",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:run:prod": "node node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/index.ts",
    "seed:booking": "ts-node -r tsconfig-paths/register src/database/seeds/seed-booking-flow.ts",
    "prepare": "husky",
    "contract:generate": "ts-node -r tsconfig-paths/register src/openapi/generate-openapi.ts --write",
    "contract:check": "ts-node -r tsconfig-paths/register src/openapi/generate-openapi.ts --check",
    "contract:validate": "oasdiff validate contracts/openapi.json --fail-on WARN --allow-external-refs=false",
    "contract:compatibility:test": "bash scripts/openapi/contract-compatibility.test.sh",
    "api-client:generate": "node scripts/api-client/generate-api-client.mjs --write",
    "api-client:check": "node scripts/api-client/generate-api-client.mjs --check",
    "api-client:build": "npm run build --workspace @ohealth/api-client",
    "api-client:test": "node scripts/api-client/verify-api-client.mjs",
    "password-blocklist:generate": "node scripts/security/update-password-blocklist.mjs --write",
    "password-blocklist:check": "node scripts/security/update-password-blocklist.mjs --check",
    "auth-challenge-delivery:dispatch": "ts-node -r tsconfig-paths/register scripts/maintenance/dispatch-auth-challenge-deliveries.ts",
    "registration-retries:prune": "ts-node -r tsconfig-paths/register scripts/maintenance/prune-registration-retries.ts"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ],
    "*.ts": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@hng-sdk/orm": "^0.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "^11.2.2",
    "@nestjs/typeorm": "^11.0.0",
    "@types/multer": "^2.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "csv-parser": "^3.2.1",
    "dotenv": "^18.0.9",
    "google-auth-library": "^10.5.0",
    "morgan": "^1.10.1",
    "nest-winston": "^1.10.2",
    "nodemailer": "10.3.1",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "resend": "^6.37.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "speakeasy": "^2.0.0",
    "typeorm": "^1.1.2",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/babel__core": "^7.20.5",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.2.1",
    "@types/nodemailer": "^7.0.3",
    "@types/nunjucks": "^3.2.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "follow-redirects": "1.16.2",
    "handlebars": "4.7.10",
    "proxy-addr": "2.0.8",
    "picomatch": "4.0.4",
    "@angular-devkit/core": {
      "ajv": "8.18.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.4.2"
    },
    "fast-uri": "^3.1.7",
    "qs": "^6.15.2",
    "uuid": "^11.1.1",
    "multer": "^2.2.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
